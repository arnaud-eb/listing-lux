# Copy to .env.local and fill in. Never commit a populated .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Market registry (lib/markets) ---
NEXT_PUBLIC_MARKET_ID=lu

# --- Upstash Redis — rate limiting (lib/rate-limit) ---
# Free tier: https://console.upstash.com/redis (10K req/day, sufficient for MVP).
# Both vars must be set to enable limiting; if either is missing, the limiter
# becomes a no-op (useful for local dev / CI).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Localities cache revalidation (lib/localities) ---
# After seed:localities runs (locally or via the quarterly cron), the script
# POSTs to /api/admin/revalidate-localities so the running Next.js app picks up
# new rows immediately. If either var is unset the script no-ops — fine for
# offline seeds against a fresh DB.
LOCALITIES_REVALIDATE_URL=http://localhost:3000
LOCALITIES_REVALIDATE_SECRET=
